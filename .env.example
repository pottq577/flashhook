# MongoDB Atlas 연동을 위한 환경 변수 (예시)
# 이 파일을 복사하여 .env 파일을 만들고 실제 주소를 입력하세요.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Redis 비밀번호 (강력한 비밀번호 사용 필수)
REDIS_PASSWORD=<strong-redis-password>

# Grafana 초기 관리자 비밀번호
GRAFANA_ADMIN_PASSWORD=<strong-grafana-password>

# QA 스크립트 실행용 Actuator 관리 포트 (선택사항, 기본값: http://localhost:9090)
BASE_MGMT=http://localhost:9090

# ==========================================
# Application Configuration
# ==========================================
# 관리자 백오피스 인증 토큰 (X-Admin-Token 헤더에 사용될 시크릿 키)
FLASHHOOK_ADMIN_SECRET_KEY=<strong-admin-token>
FLASHHOOK_SECRET_KEY=<32-byte-random-string>
