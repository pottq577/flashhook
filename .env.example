# ==========================================
# 🚀 FlashHook Production Environment Template
# ==========================================
# 이 파일은 환경변수 설정 가이드(docs/review/deployment_env_checklist.md)와
# 1:1로 매칭되는 템플릿입니다. 실제 운영 환경에서는 .env 파일로 복사해서 사용하세요.

# ------------------------------------------
# 1. Application Core (Spring Boot)
# ------------------------------------------
# (도커 컴포즈 사용 시 내부에 하드코딩되어 있으나, 단독 실행 시 필요합니다.)
SPRING_PROFILES_ACTIVE=prod

# [필수] 웹훅 시그니처 암호화 키 (32바이트 이상 무작위 문자열)
FLASHHOOK_SECRET_KEY=생성된_무작위_문자열_32바이트_이상

# [필수] 관리자(Admin) 백오피스 및 API 접근 보호용 비밀번호
FLASHHOOK_ADMIN_SECRET_KEY=강력한_어드민_비밀번호

# ------------------------------------------
# 2. Database Connection
# ------------------------------------------
# MongoDB 접속 주소 (예: Atlas Cluster URI)
MONGODB_URI=mongodb://user:pass@host:27017/flashhook

# Redis 서버 접속 정보 (Rate Limit 처리용)
REDIS_HOST=elasticache_또는_redis_컨테이너_이름
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_pass

# ------------------------------------------
# 3. Infrastructure & Monitoring
# ------------------------------------------
# Grafana 대시보드 로그인 비밀번호
GRAFANA_ADMIN_PASSWORD=강력한_비밀번호

# 메트릭 수집기(Prometheus)가 찌를 백엔드 헬스체크 및 Actuator 엔드포인트 기본 주소
# (QA 스크립트에서도 사용. 운영/로컬 모두 9090번 포트는 외부 차단 + 내부망/로컬호스트 접속이 원칙)
BASE_MGMT=http://localhost:9090
