# Frontend Environment Variables Example

# ==========================================
# Vite Configuration
# ==========================================

# 백엔드 API 서버의 기본 URL (API 요청 및 SSE 연결 시 사용됨)
# 로컬 개발 시에는 일반적으로 http://localhost:8080 을 사용합니다.
VITE_API_BASE_URL=http://localhost:8080/api

# (선택) 개발 도구용 폴백 URL
# VITE_API_URL=http://localhost:8080

# 백엔드 서버 준비 중 배너 표시 여부 (true/false)
# 컴퓨트 자원 확보 대기 시 true로 설정. 배포 완료 후 false로 변경
VITE_MAINTENANCE_MODE=false

# 구글 애드센스 광고 노출 여부 (true/false)
# 심사 대기 중이거나 광고를 숨길 때는 주석 처리하거나 false로 설정합니다.
VITE_ENABLE_ADS=false

